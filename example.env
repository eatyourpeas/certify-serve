# Certify Attendance Server - Self-hosting template
# Copy to .env and provide real values. Never commit .env.

# -----------------------------
# Required for Eventbrite flows
# -----------------------------
EVENTBRITE_TOKEN=your_eventbrite_token_here

# -----------------------------
# Required for email sending
# Used as backend defaults when send=true
# UI can override these per request when non-empty
# -----------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# -----------------------------
# Recommended sender defaults
# -----------------------------
FROM_NAME=Conference Team
FROM_EMAIL=noreply@example.com

# -----------------------------
# Optional
# Use console mode to print emails to logs instead of sending
# -----------------------------
# SMTP_BACKEND=console
